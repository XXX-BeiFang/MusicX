@startuml 音乐网站整合UML图

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 5
skinparam ArrowColor #34495e
skinparam BackgroundColor #ecf0f1
skinparam BorderColor #3498db
skinparam FontColor #2c3e50

' 定义角色
actor 用户 as User
actor 管理员 as Admin

' 核心组件
component "前端应用" as Frontend {
  component "核心组件" as Components {
    component "音乐播放器" as Player
    component "登录组件" as Login
    component "搜索组件" as Search
    component "歌单组件" as Playlist
    component "艺术家组件" as Artist
    component "MV播放器" as MV
  }
  
  component "状态管理" as Stores {
    component "用户状态" as UserStore
    component "音频状态" as AudioStore
  }
}

component "API服务" as API {
  component "网易云音乐API" as NetEaseAPI
  component "登录服务" as LoginService
  component "音乐服务" as MusicService
  component "搜索服务" as SearchService
}

' 核心类
class "用户" as UserClass {
  +userId: number
  +nickname: string
  +avatarUrl: string
  +isLoggedIn: boolean
  +login()
  +logout()
}

class "音频播放器" as AudioPlayerClass {
  +isPlaying: boolean
  +currentTrack: Track
  +currentTime: number
  +volume: number
  +play()
  +pause()
  +nextTrack()
  +prevTrack()
  +seek(time: number)
}

class "歌曲" as Track {
  +id: number
  +name: string
  +artist: string[]
  +album: string
  +duration: number
  +url: string
}

class "歌单" as PlaylistClass {
  +id: number
  +name: string
  +coverImgUrl: string
  +creator: User
  +tracks: Track[]
}

' 核心用例
usecase "登录/注册" as UC1
usecase "搜索音乐" as UC2
usecase "播放音乐" as UC3
usecase "查看/管理歌单" as UC4
usecase "查看艺术家/专辑" as UC5
usecase "观看MV" as UC6

' 用户与用例关系
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

Admin --> UC1

' 组件关系
Components --> Stores
Frontend --> API

' 类关系
UserClass -- UserStore
AudioPlayerClass -- AudioStore
AudioPlayerClass -- Track
PlaylistClass -- Track
PlaylistClass -- UserClass

' 序列关系（简化）
note right of User : 登录流程
User -> Login
Login -> LoginService : 请求二维码
LoginService --> Login : 返回二维码
Login -> LoginService : 检查状态
LoginService --> Login : 授权成功
Login -> UserStore : 保存用户信息

note right of User : 播放流程
User -> Player : 选择歌曲
Player -> AudioStore : 添加到播放列表
Player -> MusicService : 获取歌曲URL
MusicService --> Player : 返回URL
Player -> Player : 播放歌曲
Player --> User : 显示进度和歌词

@enduml