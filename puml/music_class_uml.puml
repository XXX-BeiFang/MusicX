@startuml 音乐网站类图

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

package "用户管理" {
  class User {
    +userId: number
    +nickname: string
    +avatarUrl: string
    +isLoggedIn: boolean
    +login()
    +logout()
    +checkLoginStatus()
  }
  
  class LoginQR {
    +qrKey: string
    +qrImgUrl: string
    +qrStatus: object
    +fetchQrKey()
    +createQrCode()
    +checkQrStatus()
    +startPolling()
    +stopPolling()
  }
}

package "音乐播放" {
  class AudioPlayer {
    +isPlaying: boolean
    +currentTrack: Track
    +currentTime: number
    +duration: number
    +volume: number
    +currentLyricIndex: number
    +play()
    +pause()
    +nextTrack()
    +prevTrack()
    +seek(time: number)
    +togglePlayPause()
    +setVolume(volume: number)
    +setPlayMode(mode: PlayMode)
    +loadTrack()
  }
  
  class Track {
    +id: number
    +name: string
    +artist: Artist[]
    +album: Album
    +duration: number
    +cover: string
    +url: string
    +lyrics: Lyrics
  }
  
  class Lyrics {
    +lines: LyricLine[]
    +translate: boolean
    +roma: boolean
  }
  
  class LyricLine {
    +time: number
    +text: string
    +translate: string
    +roma: string
  }
  
  enum PlayMode {
    LOOP
    ORDER
    SHUFFLE
    SINGLE
  }
}

package "内容管理" {
  class Playlist {
    +id: number
    +name: string
    +coverImgUrl: string
    +creator: User
    +description: string
    +trackCount: number
    +playCount: number
    +subscribedCount: number
    +tracks: Track[]
    +subscribe()
    +unsubscribe()
  }
  
  class Artist {
    +id: number
    +name: string
    +picUrl: string
    +albumSize: number
    +musicSize: number
    +alias: string[]
    +getAlbums()
    +getSongs()
  }
  
  class Album {
    +id: number
    +name: string
    +picUrl: string
    +artist: Artist
    +size: number
    +publishTime: number
    +description: string
    +getSongs()
  }
  
  class MV {
    +id: number
    +name: string
    +artist: Artist
    +cover: string
    +playCount: number
    +duration: number
    +url: string
  }
}

package "API服务" {
  class APIService {
    +search(params: SearchParams)
    +getPlaylistDetail(id: number)
    +getArtistDetail(id: number)
    +getAlbumDetail(id: number)
    +getMVDetail(id: number)
    +getSongUrl(id: number)
    +getLyrics(id: number)
    +getUserPlaylists(uid: number)
    +getTopPlaylists(params: object)
  }
  
  class SearchParams {
    +keywords: string
    +type: number
    +limit: number
    +offset: number
  }
}

' 用户管理关系
User -- LoginQR

' 音乐播放关系
AudioPlayer -- Track
Track -- Lyrics
Lyrics -- LyricLine
AudioPlayer -- PlayMode

' 内容管理关系
Playlist -- Track
Playlist -- User
Artist -- Album
Artist -- Track
Artist -- MV
Album -- Track

' 跨包关系
APIService -- SearchParams
APIService -- Playlist
APIService -- Artist
APIService -- Album
APIService -- MV
APIService -- Track
APIService -- User

@enduml