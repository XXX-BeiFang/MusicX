@startuml 音乐网站功能用例图

' 设置样式参数
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false
skinparam handwritten false
skinparam linetype poly

' 颜色和样式设置 (优化后)
skinparam ArrowColor #6c5ce7
skinparam ArrowThickness 1.5
skinparam ArrowFontColor #6c5ce7
skinparam ArrowFontSize 12

skinparam usecase {
  BackgroundColor #f0f4f8
  BorderColor #6c5ce7
  FontColor #2d3436
  BorderThickness 1
  RoundCorner 5
}

skinparam package {
  BackgroundColor #e8f0f7
  BorderColor #4834d4
  FontColor #2d3436
  BorderThickness 1
  RoundCorner 8
  StereotypeFontColor #4834d4
  StereotypeFontSize 10
}

skinparam note {
  BackgroundColor #ffeaa7
  BorderColor #fdcb6e
  FontColor #2d3436
  RoundCorner 5
}

skinparam legend {
  BackgroundColor #dfe6e9
  BorderColor #b2bec3
  FontColor #2d3436
  RoundCorner 5
}

' 设置为横向布局
left to right direction

' 定义角色
actor 用户 as User #left
actor 管理员 as Admin #right

' 用例分组
package "共享功能" as SharedPkg {
  usecase "登录/注册" as UC1
}

package "用户功能" as UserPkg {
  together {
    usecase "浏览音乐" as UC2
    usecase "搜索音乐" as UC3
    usecase "播放音乐" as UC4
  }
  
  together {
    usecase "查看歌单" as UC5
    usecase "创建歌单" as UC6
    usecase "收藏歌单" as UC7
  }
  
  together {
    usecase "查看艺术家" as UC8
    usecase "查看MV" as UC9
    usecase "查看专辑" as UC13
  }
  
  together {
    usecase "调整播放设置" as UC10
    usecase "AI聊天" as UC14
  }
}

package "管理员功能" as AdminPkg {
  usecase "管理用户" as UC11
  usecase "系统设置" as UC12
}

' 用户关系 - 使用包连接
User -right-> SharedPkg
User -right-> UserPkg

' 管理员关系 - 使用包连接
Admin -left-> SharedPkg
Admin -left-> AdminPkg

' 添加标题和注释
title 音乐网站系统 - MusicX 功能用例图 (横向布局)

' 添加图例
legend center
  <b>用户功能</b>: 音乐浏览与搜索、播放控制、歌单管理、内容查看、系统设置
  <b>管理员功能</b>: 用户管理、系统配置
  <b>共享功能</b>: 登录/注册
  
  <color:#3498db>◆</color> 竖向布局设计，清晰展示功能层次与用户权限
endlegend

' 添加注释
note "用户位于左侧\n可访问所有音乐功能" as N1
User .. N1

note "管理员位于右侧\n负责系统管理" as N2
Admin .. N2

@enduml